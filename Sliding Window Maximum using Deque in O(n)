#include <stdio.h>

void printMax(int arr[], int n, int k) {
    int deque[100];
    int front = 0, rear = -1;

    for (int i = 0; i < n; i++) {
        if (front <= rear && deque[front] <= i - k) {
            front++;
        }
        while (front <= rear && arr[deque[rear]] <= arr[i]) {
            rear--;
        }
        deque[++rear] = i;

        if (i >= k - 1) {
            printf("%d ", arr[deque[front]]);
        }
    }
    printf("\n");
}
